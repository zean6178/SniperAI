# ═══════════════════════════════════════════════════════════
# PUMP.FUN SNIPER BOT — Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── Wallet ────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ─── Treasury (Revenue Wallet) ─────────────────────────────
# All swap fees + subscription revenue goes here
# Use a SEPARATE wallet from your trading wallet for security!
TREASURY_WALLET=4tifC6mukaYFh333k3pFn3U4wNkTCWUFEUSYkURMZJtZ

# ─── RPC (gunakan yang cepat: Helius, Quicknode, Triton)
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WSS_URL=wss://api.mainnet-beta.solana.com

# ─── Helius (untuk token metadata & holder analysis)
HELIUS_API_KEY=your_helius_api_key

# ─── Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─── Mode
DRY_RUN=true
BOT_MODE=semi-auto

# ─── Jito (MEV protection / bundle tips)
JITO_TIP_LAMPORTS=10000
USE_JITO=false
