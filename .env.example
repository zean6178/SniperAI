# ═══════════════════════════════════════════════════════════
# PUMP.FUN SNIPER BOT — Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── Wallet ────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ─── Treasury & Revenue Wallets (Auto-Split) ──────────────
# Revenue is automatically split across 3 wallets:
TREASURY_WALLET=4tifC6mukaYFh333k3pFn3U4wNkTCWUFEUSYkURMZJtZ
REWARD_POOL_WALLET=BCH8jvDam9n6cTDjzbcjy3LWJPQUENnacskvPsz4MsUQ
DEV_FUND_WALLET=En1foxxiV7d2siSDeX6s7gMCd1Gqc2UBLWPs4C9gWBkq
# Distribution: 50% treasury | 30% reward pool | 20% development

# ─── RPC (gunakan yang cepat: Helius, Quicknode, Triton)
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WSS_URL=wss://api.mainnet-beta.solana.com

# ─── Helius (untuk token metadata & holder analysis)
HELIUS_API_KEY=your_helius_api_key

# ─── Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ─── Mode
DRY_RUN=true
BOT_MODE=semi-auto

# ─── Jito (MEV protection / bundle tips)
JITO_TIP_LAMPORTS=10000
USE_JITO=false
