# ═══════════════════════════════════════════════════════
# SNIPERAI — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets!

# ─── Wallet ──────────────────────────────────────────────────
WALLET_PRIVATE_KEY=
RPC_URL=

# ─── Treasury & Revenue Wallets (Auto-Split) ──────────────
TREASURY_WALLET=
REWARD_POOL_WALLET=
DEV_FUND_WALLET=

# ─── Helius (untuk token metadata & holder analysis)
HELIUS_API_KEY=

# ─── Mode ────────────────────────────────────────────────────
DRY_RUN=true
BOT_MODE=semi-auto

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Hybrid Merger — Signal Server ───────────────────────────
SIGNAL_SERVER_URL=
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# ─── Hybrid Merger — Jupiter Trending ────────────────────────
TRENDING_POLL_MS=60000

# ─── Jito MEV (optional) ────────────────────────────────────
USE_JITO=false
JITO_TIP_LAMPORTS=10000


# ─── Backend API ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
